{
  "name": "check-engine",
  "version": "1.14.0",
  "description": "A system version checker in Node.js",
  "main": "./lib/checkSystem.js",
  "bin": {
    "check-engine": "./bin/check-engine.js"
  },
  "files": [
    "bin/",
    "lib/",
    "!lib/*.spec.js"
  ],
  "scripts": {
    "start": "node bin/check-engine.js",
    "test": "tape lib/*.spec.js | tap-min",
    "lint": "eslint bin/**/*.js lib/**/*.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohlsen/check-engine.git"
  },
  "keywords": [
    "node"
  ],
  "author": "Mike Ohlsen",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mohlsen/check-engine/issues"
  },
  "homepage": "https://github.com/mohlsen/check-engine#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "bluebird": "3.7.2",
    "colors": "1.4.0",
    "command-line-usage": "7.0.4",
    "jsonfile": "^6.2.1",
    "semver": "^7.8.5",
    "yargs": "18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "proxyquire": "2.1.3",
    "tap-min": "3.0.0",
    "tape": "^5.10.2"
  }
}
